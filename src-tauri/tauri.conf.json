{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FloatNotes",
  "version": "0.1.0",
  "identifier": "com.willem.floatnotes",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FloatNotes",
        "width": 420,
        "height": 640,
        "resizable": true,
        "decorations": false,
        "center": true,
        "visible": true,
        "transparent": true,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
